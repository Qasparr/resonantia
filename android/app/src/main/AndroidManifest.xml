<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NOTE: no INTERNET permission. The embedded engine binds
         127.0.0.1:8765 and the WebView only ever fetches loopback;
         loopback sockets need no permission, by doctrine. -->

    <!-- HYPOTHESIS: the only feature that touches the user's own files
         is the ringtone cutter -- it reads audio from shared storage.
         Everything else (renders, playback, jobs) lives in app-private
         storage and needs no permission at all.
         METHOD:   READ_MEDIA_AUDIO on API 33+; the legacy
         READ_EXTERNAL_STORAGE capped at 32 for older devices. Both are
         dangerous permissions, so MainActivity requests at runtime.
         DOCTRINE: least privilege. No CAMERA, no RECORD_AUDIO, no
         INTERNET, no location -- the manifest asks for exactly what
         the features need, and nothing they do not. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
