^d^g ^g^g^d' ^d'^d^d'^d ^G^d^g ^d^g^d' ^G | ^d^d' ^d'^g^g'^g' ^G^d^g ^d^d'^g' ^d'^d^g^g | ^d^G ^g^G ^d^d'^g' ^g^d'^d ^G^G ^d^d'^g' ^d | ^d'^G^g^d^d^g^d^G ^d'^G^G z5 |
